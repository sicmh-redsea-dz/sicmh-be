{
  "name": "sicmh_backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "nodemon",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "tsc && node --test \"dist/tests/*.test.js\"",
    "db:provision": "ts-node src/scripts/provision-databases.ts",
    "db:push:global": "drizzle-kit push --config=drizzle.global.config.ts",
    "db:push:tenant": "drizzle-kit push --config=drizzle.config.ts",
    "db:push": "npm run db:push:global && npm run db:push:tenant",
    "db:migrate:global": "drizzle-kit migrate --config=drizzle.global.config.ts",
    "db:migrate:tenant": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate": "npm run db:migrate:global && npm run db:migrate:tenant",
    "db:seed": "ts-node src/scripts/seed.ts",
    "db:setup": "npm run db:provision && npm run db:migrate && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@node-rs/bcrypt": "^1.10.4",
    "@types/uuid": "^10.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "express-validator": "^7.2.1",
    "file-type": "^16.5.4",
    "googleapis": "^146.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.14",
    "puppeteer": "^24.15.0",
    "sharp": "^0.35.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.23",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
